stateDiagram-v2
    state "Step 1: Intake — task registered" as INTAKE
    state "Step 2: Interview — baseline and adaptive questions" as INTERVIEW
    state "Step 3: Draft plan authored" as DRAFT_PLAN
    state "Step 4: Plan disposition & acceptance gate" as PLAN_REVIEW
    state "Step 5: Independent plan review — 1 or N rounds" as MULTI_AGENT_REVIEW
    state "Step 6: Awaiting your approval" as AWAITING_APPROVAL
    state "Step 7: Approved — you said go" as APPROVED
    state "Step 8: Implementation (isolated worktree)" as IN_WORKTREE
    state "Step 9: Here's what changed — initial review" as WORKTREE_REVIEW
    state "Step 10: Multi-agent code review — 1 or N rounds" as MULTI_AGENT_CODE_REVIEW
    state "Step 11: Verifying (tests, checks)" as VERIFY_EXIT
    state "Step 12: Retrospective — survey questions" as RETROSPECTIVE
    state "Step 13: Done" as DONE

    [*] --> INTAKE
    INTAKE --> INTERVIEW
    INTERVIEW --> RETROSPECTIVE : trivial path — baseline<br/>and adaptive questions complete
    INTERVIEW --> DRAFT_PLAN : standard path — interview complete
    DRAFT_PLAN --> PLAN_REVIEW : submit plan<br/>choose additional review - yes or no
    PLAN_REVIEW --> MULTI_AGENT_REVIEW : yes — choose review method
    PLAN_REVIEW --> AWAITING_APPROVAL : no / plan accepted<br/>skip or review outcome recorded
    PLAN_REVIEW --> DRAFT_PLAN : changes requested<br/>revise artifacts and resubmit
    MULTI_AGENT_REVIEW --> PLAN_REVIEW : review complete<br/>merge outcome - repeat or accept
    MULTI_AGENT_REVIEW --> DRAFT_PLAN : changes requested<br/>revise artifacts and resubmit
    AWAITING_APPROVAL --> APPROVED : you say Proceed / Go<br/>(mandatory gate)
    APPROVED --> IN_WORKTREE
    IN_WORKTREE --> WORKTREE_REVIEW : implementation + tests done
    WORKTREE_REVIEW --> MULTI_AGENT_CODE_REVIEW : you say yes to AI code review
    WORKTREE_REVIEW --> VERIFY_EXIT : you say no — skip straight ahead
    MULTI_AGENT_CODE_REVIEW --> VERIFY_EXIT : review passed
    VERIFY_EXIT --> RETROSPECTIVE : all checks passed
    RETROSPECTIVE --> DONE : survey complete or explicitly skipped<br/>with reason
    INTAKE --> DONE : force close — interactive human authorization<br/>(available from any active state)
    DONE --> [*]
