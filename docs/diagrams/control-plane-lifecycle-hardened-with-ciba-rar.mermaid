flowchart LR
    %% HARDENED: same 13-stage canonical lifecycle, with the two genuinely
    %% coded human-only gates (Gate 1 and Human Force-Close) now backed by the
    %% authorized_actor structural classification (T1/T2, shipped this session)
    %% and, for full CIBA+RAR hardening, the transition_request/signed-proof
    %% mechanics (T3, mechanics shipped this session as a local stub; a real
    %% IdP -- Increment B -- is a separate, not-yet-authorized follow-on).
    %%
    %% Compare against control-plane-lifecycle-baseline-no-ciba-rar.mermaid.
    %% Same correction applies here: VERIFY_EXIT -> RETROSPECTIVE remains
    %% deterministic, not a human gate -- CIBA+RAR hardening does not change
    %% that edge, since it was never a human-authorization gate to begin with.
    %%
    %% Gate 3 (WORKTREE_REVIEW) is deliberately shown STILL OPEN here, not
    %% hardened -- direct user feedback caught that the first version of this
    %% diagram omitted it. This task's authorized_actor derivation only
    %% classifies an edge as human_only when transition_templates.yaml already
    %% declares approval.required=True/approver_role='human' for it.
    %% WORKTREE_REVIEW's branch decision currently declares
    %% approval.required=False, approver_role='agent_or_human' -- so even
    %% though it is operationally required by worktree-lifecycle-management.md
    %% rule 8 (human must accept the diff regardless of whether an agent review
    %% ran), neither the authorized_actor work nor CIBA+RAR mechanics in this
    %% task apply to it yet. Closing this needs a separate, not-yet-authorized
    %% prerequisite change to that edge's own approval block first.
    %%
    %% Verified directly against transition_templates.yaml (not memory):
    %% WORKTREE_REVIEW actually has 6 outgoing edges; only 2 are happy-path
    %% (matching control-plane-pipeline-happy-path.mermaid's own scope choice --
    %% the other 4 are ROLLED_BACK/ESCALATED/IN_WORKTREE/RETROSPECTIVE recovery
    %% routes, omitted here for the same reason that diagram omits them).
    %% Path A (-> MULTI_AGENT_CODE_REVIEW) has real declared questions
    %% (confirm_review_worktree_review_to_multi_agent_code_review,
    %% implementation_review_method). Path B (-> VERIFY_EXIT, the skip path)
    %% has ZERO declared questions in the YAML -- "you say no" is advisory
    %% prose text only, not an enforced question. The skip path is weaker than
    %% even an uncoded question: today it is not a question at all.

    subgraph Phase1["1. Planning & Spec"]
        direction TB
        S1["(1) INTAKE"] --> S2["(2) INTERVIEW"]
        S2 --> S3["(3) DRAFT_PLAN"]
    end

    subgraph Phase2["2. Plan Review & Human Gate 1 (hardened)"]
        direction TB
        S4["(4) PLAN_REVIEW"] --> S5["(5) MULTI_AGENT_REVIEW"]
        S5 --> S6["(6) AWAITING_APPROVAL"]
        S6 --> TR1["transition_request created<br/>by Policy Engine (not agent)<br/>nonce + revision_hash + expiry"]
        TR1 --> CIBA1{{"CIBA+RAR async push<br/>to human's own device<br/>(Increment B, not this task)"}}
        CIBA1 ==>|"Gate 1: signed proof verified<br/>(jti, expiry, payload-match,<br/>atomic consume-and-commit)"| S7["(7) APPROVED"]
    end

    subgraph Phase3["3. Execution, Verification & Human Gate 3 (still open)"]
        direction TB
        S8["(8) IN_WORKTREE"] --> S9["(9) WORKTREE_REVIEW"]
        S9 ==>|"Gate 3, path A: you say yes --<br/>STILL NOT HARDENED (not even coded as<br/>human_only yet). Prerequisite: declare<br/>approval.required=True on this edge first."| S10["(10) MULTI_AGENT_CODE_REVIEW"]
        S9 ==>|"Gate 3, path B: you say no --<br/>skip straight to verification.<br/>Same open gap either way."| S11["(11) VERIFY_EXIT"]
        S10 --> S11
    end

    subgraph Phase4["4. Closure"]
        direction TB
        S11 -->|"deterministic: test suite +<br/>leak/ledger checks<br/>(unchanged -- never a human gate)"| S12["(12) RETROSPECTIVE"]
        S12 --> S13["(13) DONE"]
    end

    Phase1 --> Phase2
    Phase2 --> Phase3
    Phase3 --> Phase4

    HumanClose{{"Human Force-Close<br/>(Any State)"}} --> TR2["transition_request created<br/>by Policy Engine"]
    TR2 --> CIBA2{{"CIBA+RAR async push<br/>(Increment B)"}}
    CIBA2 -.->|"Gate: signed proof verified,<br/>same mechanics as Gate 1"| S13

    %% STRUCTURAL REFUSAL, closing the baseline's actual gap for Gates 1 and
    %% Force-Close (T2, this session): coordinator.py now checks
    %% authorized_actor='human_only' BEFORE constructing any prompt for those
    %% edges. An agent-driven attempt (direct instantiation, spoofed actor,
    %% piped stdin) is refused structurally -- verified by adversarial tests.
    %% Gate 3 gets none of this yet -- see note above.
    classDef hardened fill:#e0ffe0,stroke:#080,stroke-width:2px
    classDef mechanics fill:#e0e8ff,stroke:#448,stroke-width:1px
    classDef uncoded fill:#fff3cd,stroke:#b8860b,stroke-width:2px
    class S6,S7,HumanClose hardened
    class TR1,TR2,CIBA1,CIBA2 mechanics
    class S9,S10,S11 uncoded
