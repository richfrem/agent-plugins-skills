flowchart TB
    %% Production gates: human key in context/control_plane.db; first signature binds one key.
    %% Simulation: separate context/simulation/simulation_control_plane.db and agent key only.
    %% Complete captured signed evidence is reverified before a production push.
    %% HARDENED (Schema v15): 10-state canonical lifecycle (8 happy-path + RECOVERING, ROLLED_BACK)
    %% - Exactly three human authorities are CRYPTOGRAPHIC: APPROVED (Gate 1, from PLAN_REVIEW),
    %%   VERIFY_EXIT (Gate 3, from WORKTREE_REVIEW) and DONE (closure, from VERIFY_EXIT or early
    %%   close from any active state). Each edge declares requires_cryptographic_proof in transition_templates.yaml.
    %% - The only valid authority is an out-of-band OpenSSH signature (ssh-keygen -Y sign, passphrase
    %%   prompted on a TTY) over a content-bound transition_request, verified against allowed_signers.
    %% - No prompt, typed word, flag, receipt or actor='human' string can authorize these edges, and
    %%   no SQLite trigger trusts an actor column for them. (CIBA+RAR push to an IdP was the earlier
    %%   design; it is superseded by local SSH signing.)
    %% - The slow work (live snapshot hashing, ssh-keygen verify) runs BEFORE the commit's BEGIN IMMEDIATE;
    %%   inside the transaction the request is re-checked and consumed exactly once.
    %% - No direct IN_WORKTREE -> VERIFY_EXIT edge exists: all work passes through WORKTREE_REVIEW
    %%   so the diff (and optional adversarial code review) is shown first.
    %% - Review preset selection and waiver decisions use signed_decisions (control-plane-decision/1).

    subgraph Phase1["1. Intake & Plan Drafting"]
        S1["(1) INTAKE<br/>(includes scoping questions & outline)"] --> S2["(2) DRAFT_PLAN<br/>(spec + plan + strategy)"]
        S2 --> S3["(3) PLAN_REVIEW<br/>(plan review + adversarial audit)"]
    end

    subgraph Phase2["2. Plan Review & Human Gate 1 (Cryptographic)"]
        S3 -->|"revise plan"| S2
        S3 --> TR1["coordinator halts: HUMAN_PROOF_REQUIRED<br/>transition_request created (not by the agent)<br/>nonce + expiry + spec/plan/verdict snapshot"]
        TR1 --> SIGN1{{"Human: show-challenge, then<br/>ssh-keygen -Y sign on a TTY<br/>(OpenSSH prompts for the passphrase)"}}
        SIGN1 ==>|"Gate 1: approve-transition verifies the signature<br/>against allowed_signers, then consumes the request<br/>once inside the commit transaction"| S4["(4) APPROVED"]
    end

    subgraph Phase3["3. Execution & Human Gate 3 (Cryptographic)"]
        S4 --> S5["(5) IN_WORKTREE"]
        S5 --> S6["(6) WORKTREE_REVIEW<br/>(diff + optional adversarial code review)"]
        S6 -->|"fix findings in worktree"| S5
        S6 --> TR3["transition_request binds: commit SHA,<br/>tracked-diff hash, untracked-files hash"]
        TR3 --> SIGN3{{"Human signs with ssh-keygen -Y sign<br/>(same flow; no skip flag exists)"}}
        SIGN3 ==>|"Gate 3: code & worktree acceptance"| S7["(7) VERIFY_EXIT<br/>(tests + leak/ledger checks + retrospective)"]
    end

    subgraph Phase4["4. Closure (Cryptographic)"]
        S7 --> TR4["transition_request also binds<br/>the retrospective digest"]
        TR4 --> SIGN4{{"Human signs closure"}}
        SIGN4 ==>|"Closure gate: signature verified,<br/>request consumed"| S8["(8) DONE"]
    end

    %% Phase-to-phase vertical layout flow
    Phase1 --> Phase2
    Phase2 --> Phase3
    Phase3 --> Phase4

    %% Early close from any active state uses the SAME signed closure gate (no force-close string or flag)
    EarlyClose{{"Early close<br/>(any active state)"}} --> TR2["transition_request created<br/>(same mechanics as Gate 1)"]
    TR2 --> SIGN2{{"Human signs with ssh-keygen -Y sign"}}
    SIGN2 -.->|"Closure gate: signature verified,<br/>request consumed"| S8

    %% Styling definitions
    classDef hardened fill:#e0ffe0,stroke:#080,stroke-width:2px
    classDef localMechanics fill:#e0e8ff,stroke:#336699,stroke-width:1.5px
    classDef signing fill:#f3e8ff,stroke:#7b2cbf,stroke-width:2px
    classDef gated fill:#d4edda,stroke:#28a745,stroke-width:2px

    %% Node assignments
    class S4,S7,S8,EarlyClose hardened
    class TR1,TR2,TR3,TR4 localMechanics
    class SIGN1,SIGN2,SIGN3,SIGN4 signing
    class S3,S6 gated
