    classDef p4Style fill:#ecfeff,stroke:#06b6d4,stroke-width:1px
    classDef gateStyle fill:#fff7ed,stroke:#ea580c,stroke-width:2px
    classDef p5Style fill:#f5f3ff,stroke:#7c3aed,stroke-width:1px
    classDef p6Style fill:#fefce8,stroke:#ca8a04,stroke-width:1px
    classDef p7Style fill:#f0fdf4,stroke:#16a34a,stroke-width:1px
    classDef endStyle fill:#dcfce7,stroke:#15803d,stroke-width:3px

    class Start startStyle
    class Phase1,P1Analyze,P1Report p1Style
    class Phase2,P2Tests p2Style
